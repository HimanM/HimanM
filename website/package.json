{
  "name": "HimanM-Porfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-data": "node -e \"const fs = require('fs'); const path = require('path'); for (const f of ['certifications.json', 'profile.json']) { const src = path.resolve('..', f); const dest = path.resolve('data', f); if (fs.existsSync(src)) { fs.copyFileSync(src, dest); console.log('Synced ' + f + ' from root'); } }\"",
    "predev": "npm run sync-data",
    "prebuild": "npm run sync-data",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean"
  },
  "dependencies": {
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "next-themes": "^0.4.6",
    "postcss": "^8.4.38",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
